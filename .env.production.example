# Copie este arquivo para .env.production ou configure estas mesmas variáveis na Vercel.
# O app também aceita os aliases sem FIREBASE_ no vite.config.js, mas o padrão recomendado é VITE_FIREBASE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
